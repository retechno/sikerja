# Salin ke .env lalu sesuaikan. Jangan commit .env.
APP_ENV=development

# --- API ---
# Port API di host (ubah bila 8080 dipakai aplikasi lain)
API_PORT=8080
HTTP_ADDR=:8080
DB_DSN=sikerja:sikerja@tcp(mysql:3306)/sikerja?charset=utf8mb4&parseTime=true&loc=Local
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
# Wajib diganti di production (min. 32 karakter acak): openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
COOKIE_SECURE=false
STORAGE_DIR=/app/storage
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
AUTO_MIGRATE=true
# Zona waktu jadwal harian worker (pengingat tenggat penilaian pukul 08.00)
APP_TIMEZONE=Asia/Jakarta

# --- Email (Mailpit di lokal: UI http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=SiKerja <no-reply@sikerja.test>
SMTP_USER=
SMTP_PASSWORD=

# --- MySQL (dipakai container mysql) ---
MYSQL_DATABASE=sikerja
MYSQL_USER=sikerja
MYSQL_PASSWORD=sikerja
MYSQL_ROOT_PASSWORD=root
