# Salin ke .env di server (cp .env.production.example .env) lalu isi SEMUA nilai. Jangan commit .env.
# Gunakan hanya huruf/angka untuk password database (karakter @ / : ? merusak DSN): openssl rand -hex 16

# URL publik aplikasi (dipakai untuk CORS dan tautan di email), tanpa garis miring di akhir
APP_URL=https://sikerja.perusahaan.id
APP_TIMEZONE=Asia/Jakarta

# Port web di host. Bawaan hanya 127.0.0.1 (Nginx host menghentikan TLS). 0.0.0.0 bila tanpa Nginx host.
WEB_BIND=127.0.0.1
WEB_PORT=8081
# Biarkan true. false hanya bila sementara diakses lewat HTTP biasa (login tidak aman).
COOKIE_SECURE=true

# openssl rand -hex 32  (min. 32 karakter; mengganti nilai ini mengeluarkan semua pengguna)
JWT_SECRET=
MYSQL_DATABASE=sikerja
MYSQL_USER=sikerja
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# Email keluar (SMTP). Contoh port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=SiKerja <no-reply@perusahaan.id>
SMTP_USER=
SMTP_PASSWORD=

# Hanya untuk instalasi pertama (service `bootstrap`); hapus ADMIN_PASSWORD dari berkas setelah selesai.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
